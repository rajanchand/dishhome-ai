# Secrets / env — match in every subdirectory, including backend/.env
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
dist/
.vite/
.npm/
.pnp.*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/tsconfig.tsbuildinfo
# Stray TS emit next to sources (tsconfig has noEmit, this is a safety net)
frontend/src/**/*.js
frontend/src/**/*.js.map
frontend/src/**/*.d.ts
!frontend/src/vite-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
*.tar

# Recordings (large binary, shouldn't be in git)
recordings/
*.wav
*.mp3
*.opus

# Runtime artifacts (backend creates this dir on startup)
backend/voice_uploads/
frontend/.env.local
.vercel
.env*.local
