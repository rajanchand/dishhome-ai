# DishHome AI Call Center - Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.

# ---- App Settings ----
APP_ENV=development             # development, staging, production
APP_LOG_LEVEL=info              # debug, info, warning, error
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=3000

# ---- Build Targets ----
# For local dev use 'development'. For production use 'production'
BACKEND_BUILD_TARGET=development
FRONTEND_BUILD_TARGET=development

# ---- PostgreSQL Database ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dishhome_ai
POSTGRES_USER=dishhome
POSTGRES_PASSWORD=dishhome_secret

# ---- Redis Cache & State ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Supabase (Postgres Persistence layer) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=dh

# ---- AI Engine: Ollama (Local LLM) ----
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:70b

# ---- AI Engine: ElevenLabs (Voice Cloning & TTS) ----
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_NE_FEMALE=
ELEVENLABS_VOICE_NE_MALE=
ELEVENLABS_VOICE_EN_FEMALE=
ELEVENLABS_VOICE_EN_MALE=

# ---- Speech-to-Text (faster-whisper) ----
STT_MODEL=large-v3
STT_DEVICE=cuda                # 'cuda' for NVIDIA GPU, 'cpu' for CPU-only
STT_COMPUTE_TYPE=float16       # float16 for GPU, int8 for CPU

# ---- Text-to-Speech (Piper Fallback) ----
TTS_VOICE=dishhome-ne-female-v1
TTS_SAMPLE_RATE=22050

# ---- Telephony: Twilio Integration ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURES=true

# ---- FreeSWITCH Bridge ----
FREESWITCH_AUDIOSOCKET_HOST=0.0.0.0
FREESWITCH_AUDIOSOCKET_PORT=4000

# ---- External ISP Integrations ----
BILLING_API_BASE_URL=
BILLING_API_KEY=
OSS_API_BASE_URL=
OSS_API_KEY=
TICKETING_API_BASE_URL=
TICKETING_API_KEY=
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# ---- Security & Networking ----
PUBLIC_BASE_URL=
# CORS for local Vite and production domains
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_SECRET_KEY=generate_me_with_python_secrets_token_urlsafe_64
VITE_API_BASE=http://localhost:8000
ENABLE_AUDIO_SERVER=true
