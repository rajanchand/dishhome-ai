# Copy to .env and fill in real values. Never commit .env.

# ---- App ----
APP_ENV=development
APP_LOG_LEVEL=info
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dishhome_ai
POSTGRES_USER=dishhome
POSTGRES_PASSWORD=

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Ollama (LLM) ----
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:70b

# ---- STT (faster-whisper) ----
STT_MODEL=large-v3
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16

# ---- TTS (Piper) ----
TTS_VOICE=dishhome-ne-female-v1
TTS_SAMPLE_RATE=22050

# ---- FreeSWITCH bridge ----
FREESWITCH_AUDIOSOCKET_HOST=0.0.0.0
FREESWITCH_AUDIOSOCKET_PORT=4000

# ---- ISP integrations (set in real env) ----
BILLING_API_BASE_URL=
BILLING_API_KEY=
OSS_API_BASE_URL=
OSS_API_KEY=
TICKETING_API_BASE_URL=
TICKETING_API_KEY=
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
