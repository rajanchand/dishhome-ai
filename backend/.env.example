# DishHome AI Call Center — backend environment
# Copy to backend/.env and fill in. Never commit the real .env.

# --- Networking ---
APP_HOST=0.0.0.0
APP_PORT=8000
# Public origin Twilio uses to fetch TwiML + post status callbacks.
# In dev: run `ngrok http 8000` and paste the https URL here.
# In prod: your real domain, e.g. https://api.dishhome.com.np
PUBLIC_BASE_URL=

# Allow both Vite (3000) and the ngrok URL above
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- ElevenLabs (voice cloning + TTS) ---
# Sign up at https://elevenlabs.io → Profile → API key
# Free tier: 10k chars/mo. Creator plan ($22/mo) gives you Instant Voice Clones.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Default voice_ids for the four built-in personas.
# Either pick from ElevenLabs' library (e.g. "EXAVITQu4vr4xnSDxMaL" for Bella)
# or upload a 1-min sample via the UI → Voice Lab → Clone (Bibek / Priya etc.)
# and paste the returned voice_id here.
ELEVENLABS_VOICE_NE_FEMALE=
ELEVENLABS_VOICE_NE_MALE=
ELEVENLABS_VOICE_EN_FEMALE=
ELEVENLABS_VOICE_EN_MALE=

# --- Twilio (outbound calls) ---
# Sign up at https://twilio.com (free trial: ~$15 credit).
# Console → Account info → Account SID + Auth Token.
# Buy a number (or use trial number) at Console → Phone Numbers → Buy.
# Verify your test mobile (UK 07570731478 → +447570731478) at:
#   Console → Phone Numbers → Verified Caller IDs
# Trial accounts can ONLY call verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Optional infra (already wired but not required for demo) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
REDIS_HOST=localhost
REDIS_PORT=6379
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dishhome_ai
POSTGRES_USER=dishhome
POSTGRES_PASSWORD=
